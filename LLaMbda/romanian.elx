Stiu       : s                              = they <= know_answer.
Dormiti    : np2pl \ s                      = lambda subjects : subjects <= sleeping.
Dormiti    : s                              = you_plural <= sleeping.
Ma         : (np1sg \ s) / rv1sg            = lambda verb : lambda subjects : all(verb(x)(x) for x in subjects).
Ma         : s / rv1sg                      = lambda verb : all(verb(x)(x) for x in speaker).
Va         : (np2pl \ s) / rv2pl            = lambda verb : lambda subjects : all(verb(x)(x) for x in subjects).
Va         : s / rv2pl                      = lambda verb : all(verb(x)(x) for x in you_plural).
